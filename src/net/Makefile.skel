#
#  Makefile for GXemul src/net
#

CFLAGS=$(CWARNINGS) $(COPTIM) $(DISPLAYINCLUDE) $(DINCLUDE) -I../include/thirdparty $(DEPFLAGS)

OBJS=net.o net_ip.o net_l2tp.o net_misc.o net_tap.o net_ether.o

all: $(OBJS)

$(OBJS): Makefile

-include $(OBJS:.o=.d)


clean:
	rm -f $(OBJS) $(OBJS:.o=.d) *.d *core

clean_all: clean
	rm -f Makefile

