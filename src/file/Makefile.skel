#
#  Makefile for GXemul src/file
#

CFLAGS=$(CWARNINGS) $(COPTIM) $(DINCLUDE) $(DEPFLAGS)

OBJS=file.o gunzip.o puff.o unzip.o

all: $(OBJS)

$(OBJS): Makefile

-include $(OBJS:.o=.d)

file.o: file.c file_android.c file_aout.c file_ecoff.c file_elf.c \
	file_macho.c file_raw.c file_srec.c

gunzip.o puff.o unzip.o: puff.h


clean:
	rm -f $(OBJS) $(OBJS:.o=.d) *.d *core

clean_all: clean
	rm -f Makefile

