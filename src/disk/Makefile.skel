#
#  Makefile for GXemul src/disk
#

CFLAGS=$(CWARNINGS) $(COPTIM) $(DINCLUDE) $(DEPFLAGS)

OBJS=bootblock.o bootblock_apple.o bootblock_iso9660.o \
	diskimage.o diskimage_scsicmd.o

all: $(OBJS)

$(OBJS): Makefile

-include $(OBJS:.o=.d)


clean:
	rm -f $(OBJS) $(OBJS:.o=.d) *.d *core

clean_all: clean
	rm -f Makefile

